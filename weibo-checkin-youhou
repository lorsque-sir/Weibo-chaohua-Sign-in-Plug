    function formatDateStr(ts) {
        if (!ts) return "";
        const d = new Date(typeof ts === "string" && !isNaN(Number(ts)) ? Number(ts) : ts);
        if (isNaN(d.getTime())) return "";
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, "0");
        const day = String(d.getDate()).padStart(2, "0");
        return `${y}-${m}-${day}`;
    }

    const isNewDay = ts => {
        if (!ts) return true;
        const dateStr = formatDateStr(ts);
        if (!dateStr) return true;
        return dateStr !== formatDateStr(Date.now());
    };

    const storage = {
        set: (k, v) => {
            try {
                if (typeof GM_setValue !== "undefined") {
                    GM_setValue(k, JSON.stringify(v));
                }
            } catch (e) {}
            localStorage.setItem(k, JSON.stringify(v));
        },
        get: (k) => {
            let v;
            try {
                if (typeof GM_getValue !== "undefined") {
                    v = GM_getValue(k);
                }
            } catch (e) {}
            if (v === undefined || v === null) {
                v = localStorage.getItem(k);
            }
            try { return JSON.parse(v); } catch (e) { return v; }
        },
        remove: (k) => {
            try {
                if (typeof GM_deleteValue !== "undefined") {
                    GM_deleteValue(k);
                }
            } catch (e) {}
            localStorage.removeItem(k);
        }
    };

    const idGen = (e => () => e++)(0);
    const KEY_SIGNED_ARR = "WB_SIGNED_ARR";
    const KEY_CONFIG = "WB_CONFIG";
    const KEY_TOPICS_ALL = "WB_TOPICS_ALL";
    const KEY_LAST_CHECK = "lastCheck";
    const KEY_IS_CHECK = "isCheck";

    const DEFAULT_CONFIG = {
        AUTO_SIGN: true,
        SHOW_TOAST: true,
        TIMEOUT: 2000
    };

    let config = storage.get(KEY_CONFIG) || DEFAULT_CONFIG;

    // Toast Notification Manager
    let activeToastCount = 0;
    const MAX_TOASTS = 8;
    const createToastItem = e => {
        const { content, type, timeout, id } = e;
        function remove() {
            const el = document.querySelector(`[data-tid='${id}']`);
            if (el) {
                el.classList.add("removing");
                requestAnimationFrame(() => {
                    if (el.parentNode) el.parentNode.removeChild(el);
                    activeToastCount--;
                });
            }
        }
        if (timeout) setTimeout(remove, timeout);
        return VM.createElement("div", {
            "data-tid": id,
            className: `toastItem toast-${type}`,
            onClick: remove
        }, content);
    };

    const toastFactory = () => {
        const container = VM.createElement("div", { className: "msgContainer" }, VM.createElement("style", null, cssStyle));
        let mountedEl = null;

        const ensureMount = () => {
            if (!mountedEl && document.body) {
                mountedEl = document.body.appendChild(container);
            }
            return mountedEl;
        };

        const show = (content, opts = {}) => {
            if (!storage.get(KEY_CONFIG)?.SHOW_TOAST) return;
            const parent = ensureMount();
            if (!parent) return;
            const itemOpts = Object.assign({ id: idGen(), type: "info", timeout: 4000, content }, opts);
            if (activeToastCount < MAX_TOASTS) {
                activeToastCount++;
                parent.appendChild(createToastItem(itemOpts));
            }
        };

        return {
            success: (msg, opts) => show(msg, { ...opts, type: "success" }),
            error: (msg, opts) => show(msg, { ...opts, type: "error" }),
            info: (msg, opts) => show(msg, { ...opts, type: "info" }),
            warn: (msg, opts) => show(msg, { ...opts, type: "warning" })
        };
    };

    const toast = toastFactory();
    window.toast = toast;

    const axiosInstance = axios.create({
        baseURL: `${location.origin}/`,
        withCredentials: true,
        timeout: 10000
    });
    axiosInstance.defaults.headers.post["Content-Type"] = "application/x-www-form-urlencoded";

    function delay(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }

    class PromiseQueue {
        constructor({ concurrency = 1, minTimeout = 1000, maxTimeout = 1800 } = {}) {
            this.queue = [];
            this.running = 0;
            this.concurrency = concurrency;
            this.minTimeout = minTimeout;
            this.maxTimeout = maxTimeout;
        }
        add(fn) {
            return new Promise((resolve, reject) => {
                const task = async () => {
                    try {
                        const res = await fn();
                        const randomDelay = this.minTimeout + Math.floor(Math.random() * (this.maxTimeout - this.minTimeout));
                        await delay(randomDelay);
                        resolve(res);
                    } catch (err) {
                        reject(err);
                    } finally {
                        this.running--;
                        this.processQueue();
                    }
                };
                this.queue.push(task);
                this.processQueue();
            });
        }
        processQueue() {
            while (this.running < this.concurrency && this.queue.length > 0) {
                this.running++;
                const task = this.queue.shift();
                task();
            }
        }
    }

    // 跨域网络请求封装：优先使用 GM_xmlhttpRequest（可携带当前 Cookie 且无 CORS 限制），环境不支持时降级为 fetch
    function gmFetchJson(url, options = {}) {
        return new Promise((resolve, reject) => {
            const timeout = options.timeout || 15000;
            const headers = Object.assign({
                "Accept": "application/json, text/plain, */*",
                "MWeibo-Pwa": "1",
                "Referer": "https://m.weibo.cn/p/tabbar?containerid=100803_-_recentvisit&page_type=tabbar",
                "X-Requested-With": "XMLHttpRequest",
                "Cookie": document.cookie || ""
            }, options.headers || {});

            if (typeof GM_xmlhttpRequest !== "undefined") {
                GM_xmlhttpRequest({
                    method: options.method || "GET",
                    url: url,
                    headers: headers,
                    timeout: timeout,
                    onload: (res) => {
                        if (res.status >= 200 && res.status < 300) {
                            try {
                                resolve(JSON.parse(res.responseText));
                            } catch (e) {
                                reject(new Error("JSON解析失败: " + e.message));
                            }
                        } else {
                            reject(new Error(`HTTP ${res.status}`));
                        }
                    },
                    onerror: (err) => reject(new Error("网络请求失败: " + (err?.statusText || "未知错误"))),
                    ontimeout: () => reject(new Error("请求超时"))
                });
            } else {
                fetch(url, {
                    method: options.method || "GET",
                    headers: headers,
                    credentials: "include"
                })
                .then(r => {
                    if (!r.ok) throw new Error(`HTTP ${r.status}`);
                    return r.json();
                })
                .then(resolve)
                .catch(reject);
            }
        });
    }

    // 从移动端接口获取关注超话，并直接识别服务端当天的实时签到状态（针对在手机端或其他设备已签到的超话）
    async function getTopicsFromMWeibo() {
        const allCards = [];
        let sinceId = undefined;
        let pageCount = 0;
        const maxPages = 30; // 最多30页保护

        while (pageCount < maxPages) {
            pageCount++;
            let url = "https://m.weibo.cn/api/container/getIndex?containerid=100803_-_followsuper";
            if (sinceId) {
                url += `&since_id=${encodeURIComponent(sinceId)}`;
            }

            const data = await gmFetchJson(url, { timeout: 12000 });
            if (data?.ok !== 1 || !data?.data) {
                if (pageCount === 1) {
                    throw new Error("移动端接口未返回有效数据");
                }
                break;
            }

            const cards = data.data.cards || [];
            allCards.push(...cards);

            const info = data.data.cardlistInfo || {};
            sinceId = info.since_id;
            if (!sinceId) break;

            await delay(350 + Math.floor(Math.random() * 200));
        }

        const topics = [];
        const signedSet = new Set();

        for (const card of allCards) {
            const groups = card?.card_group || [];
            for (const item of groups) {
                if (!item?.title_sub) continue;
                const name = (item.title_sub || "").trim();
                if (!name) continue;

                // 提取超话 ID (用于后续可能的签到)
                let topicId = "";
                if (item.containerid) {
                    topicId = item.containerid.replace(/^1022:/, "");
                } else if (item.scheme) {
                    const m = item.scheme.match(/100808[a-zA-Z0-9_-]+/);
                    if (m) topicId = m[0];
                }
                if (!topicId && item.buttons?.[0]?.scheme) {
                    const m = item.buttons[0].scheme.match(/100808[a-zA-Z0-9_-]+/);
                    if (m) topicId = m[0];
                }

                // 核心：识别是否已签到
                // 在移动端接口中，已签到的超话按钮文案通常为“已签到”或“明日再来”，或者在 desc1 中带有“已签到”
                let isSigned = false;
                if (Array.isArray(item.buttons)) {
                    for (const btn of item.buttons) {
                        const bName = (btn?.name || "").trim();
                        if (["已签", "已签到", "今日已签", "明日再来"].includes(bName) || bName.includes("已签")) {
                            isSigned = true;
                            break;
                        }
                    }
                }
                const desc1 = item.desc1 || "";
                if (!isSigned && (desc1.includes("已签") || desc1.includes("明日再来"))) {
                    isSigned = true;
                }

                if (isSigned) {
                    signedSet.add(name);
                }

                topics.push({
                    id: topicId,
                    name,
                    isSigned,
                    scheme: item.buttons?.[0]?.scheme || ""
                });
            }
        }

        if (topics.length === 0) {
            throw new Error("移动端接口未解析出有效超话列表");
        }

        return {
            topics,
            signedNames: Array.from(signedSet)
        };
    }

    // PC 端网页接口获取关注超话（作为备用兜底降级方案，同时支持状态探测）
    function getInterestNameAId(page = 1) {
        return new Promise((resolve, reject) => {
            axiosInstance({
                url: `ajax/profile/topicContent?tabid=231093_-_chaohua&page=${page}`
            }).then(resp => {
                const { data: { data, ok } } = resp;
                if (ok !== 1 || !data) {
                    reject({ err: "获取关注超话失败", data });
                    return;
                }
                const list = data.list || [];
                const maxPage = data.max_page || 1;
                const topics = list.map(item => {
                    const name = (item.topic_name || "").trim();
                    let isSigned = false;
                    if (item.is_sign === 1 || item.is_sign === true || item.is_signed === 1 || item.sign_status === 1) {
                        isSigned = true;
                    } else if (typeof item.desc1 === "string" && item.desc1.includes("已签")) {
                        isSigned = true;
                    } else if (typeof item.desc === "string" && item.desc.includes("已签")) {
                        isSigned = true;
                    } else if (Array.isArray(item.buttons)) {
                        for (const b of item.buttons) {
                            const bName = b?.name || "";
                            if (bName.includes("已签") || bName === "明日再来") {
                                isSigned = true;
                                break;
                            }
                        }
                    }
                    return {
                        id: item.oid ? item.oid.slice(5) : "",
                        name,
                        isSigned
                    };
                });
                if (page < maxPage) {
                    getInterestNameAId(page + 1).then(nextList => resolve(topics.concat(nextList))).catch(() => resolve(topics));
                } else {
                    resolve(topics);
                }
            }).catch(err => reject(err));
        });
    }

    // 综合调度器：优先获取带签到状态的移动端数据，遇异常自动回退到网页端
    async function fetchTopicsWithStatus() {
        try {
            const mResult = await getTopicsFromMWeibo();
            if (mResult && mResult.topics.length > 0) {
                return mResult;
            }
        } catch (err) {
            console.warn("[微博超话自动签到] 移动端实时状态接口调用异常，已自动回退到PC端接口:", err.message || err);
        }

        const pcTopics = await getInterestNameAId();
        const signedNames = pcTopics.filter(t => t.isSigned).map(t => t.name);
        return {
            topics: pcTopics,
            signedNames
        };
    }

    function signInterestAPI(topicId) {
        return axiosInstance({
            url: "p/aj/general/button",
            params: {
                ajwvr: 6,
                api: "http://i.huati.weibo.com/aj/super/checkin",
                texta: encodeURI("签到"),
                textb: encodeURI("已签到"),
                status: 0,
                id: topicId,
                __rnd: Date.now()
            }
        });
    }

    async function signInterestMobile(scheme) {
        if (!scheme) throw new Error("没有移动端签到链接");
        const fullUrl = scheme.startsWith("http") ? scheme : `https://m.weibo.cn${scheme}`;
        const data = await gmFetchJson(fullUrl, { timeout: 10000 });
        return data?.ok === 1;
    }

    function cleanToastMsg(msg) {
        if (!msg) return "已签到";
        return msg.replace(/\(\d+\)/g, "").trim();
    }

    async function signInterest({ id, name, scheme }, retries = 2) {
        name = (name || "").trim();
        let attempt = 0;
        while (attempt <= retries) {
            try {
                // 如果有 topicId，优先走 PC 端标准签到接口
                if (id) {
                    const resp = await signInterestAPI(id);
                    const { data } = resp;
                    const signedArr = storage.get(KEY_SIGNED_ARR) || [];

                    if (data && data.code === "100000") {
                        const extraInfo = data.data?.alert_title ? ` --- ${data.data.alert_title}` : (data.msg ? ` (${data.msg})` : "");
                        toast.success(`[${name}] 签到成功！${extraInfo}`);
                        storage.set(KEY_LAST_CHECK, Date.now());
                        if (!signedArr.includes(name)) {
                            signedArr.push(name);
                            storage.set(KEY_SIGNED_ARR, signedArr);
                        }
                        if (window.renderWBTopicList) window.renderWBTopicList();
                        return { ok: true, name };
                    }

                    const msgStr = data?.msg || "";
                    const displayMsg = cleanToastMsg(msgStr);

                    // 限流冷却：若提示频繁/太快/100002，挂起冷却 4 秒
                    if (msgStr.includes("频繁") || msgStr.includes("太快") || data?.code === "100002") {
                        toast.warn(`[${name}] 触发微博限流保护，冷却 4 秒后重试...`);
                        await delay(4000);
                    }

                    if (data?.code === 382004 || msgStr.includes("已签")) {
                        toast.warn(`[${name}] ${displayMsg}`);
                        storage.set(KEY_LAST_CHECK, Date.now());
                        if (!signedArr.includes(name)) {
                            signedArr.push(name);
                            storage.set(KEY_SIGNED_ARR, signedArr);
                        }
                        if (window.renderWBTopicList) window.renderWBTopicList();
                        return { ok: true, name };
                    }
                } else if (scheme) {
                    // 没有 topicId 但有移动端签到 scheme
                    const ok = await signInterestMobile(scheme);
                    if (ok) {
                        toast.success(`[${name}] 签到成功！`);
                        storage.set(KEY_LAST_CHECK, Date.now());
                        const signedArr = storage.get(KEY_SIGNED_ARR) || [];
                        if (!signedArr.includes(name)) {
                            signedArr.push(name);
                            storage.set(KEY_SIGNED_ARR, signedArr);
                        }
                        if (window.renderWBTopicList) window.renderWBTopicList();
                        return { ok: true, name };
                    }
                }

                if (attempt < retries) {
                    attempt++;
                    await delay(1500 * attempt);
                    continue;
                }

                toast.error(`[${name}] 签到未成功`);
                throw new Error("签到未成功");
            } catch (err) {
                if (attempt < retries) {
                    attempt++;
                    await delay(1500 * attempt);
                    continue;
                }
                toast.error(`[${name}] 签到网络异常`);
                throw err;
            }
        }
    }

    // Config & UI Panel
    let activeTab = "all"; // 'all' | 'signed' | 'pending'

    function renderList() {
        const listEl = document.getElementById("wbTopicListContainer");
        if (!listEl) return;
        listEl.innerHTML = "";

        let allTopics = storage.get(KEY_TOPICS_ALL) || [];
        const signedArr = (storage.get(KEY_SIGNED_ARR) || []).map(n => (n || "").trim());

        // 并集融合保护：防止 signedArr 里有但 allTopics 缺失的情况
        const allNames = new Set(allTopics.map(t => (t.name || "").trim()));
        signedArr.forEach(name => {
            if (!allNames.has(name)) {
                allTopics.push({ id: "", name });
                allNames.add(name);
            }
        });

        let filtered = allTopics;
        if (activeTab === "signed") {
            filtered = allTopics.filter(t => signedArr.includes((t.name || "").trim()));
        } else if (activeTab === "pending") {
            filtered = allTopics.filter(t => !signedArr.includes((t.name || "").trim()));
        }

        if (filtered.length === 0) {
            listEl.appendChild(VM.createElement("div", { className: "emptyTopicText" }, "暂无相关超话数据"));
        } else {
            filtered.forEach((t, index) => {
                const isSigned = signedArr.includes((t.name || "").trim());
                const itemEl = VM.createElement("div", { className: "topicItem" },
                    VM.createElement("div", { className: "topicLeft" },
                        VM.createElement("span", { className: "topicIndex" }, `${index + 1}.`),
                        VM.createElement("span", { className: "topicName", title: t.name }, t.name)
                    ),
                    VM.createElement("span", { className: `statusBadge ${isSigned ? 'badge-success' : 'badge-pending'}` }, isSigned ? "已签到" : "待签到")
                );
                listEl.appendChild(itemEl);
            });
        }

        // 更新选项卡标签文本与数字
        const tabAll = document.getElementById("tabAllBtn");
        const tabSigned = document.getElementById("tabSignedBtn");
        const tabPending = document.getElementById("tabPendingBtn");
        if (tabAll) tabAll.textContent = `全部 (${allTopics.length})`;
        if (tabSigned) tabSigned.textContent = `已签 (${signedArr.length})`;
        if (tabPending) tabPending.textContent = `待签 (${Math.max(0, allTopics.length - signedArr.length)})`;
    }

    window.renderWBTopicList = renderList;

    function ConfigPanel() {
        const updateState = (updater) => {
            config = Object.assign({}, config, updater);
            storage.set(KEY_CONFIG, config);
        };

        const togglePanel = () => {
            const container = document.querySelector(".configContainer");
            if (container) container.classList.toggle("active");
            renderList();
        };

        const switchTab = (tab) => {
            activeTab = tab;
            document.querySelectorAll(".tabBtn").forEach(b => b.classList.remove("active"));
            const currentTabBtn = document.getElementById(`tab${tab.charAt(0).toUpperCase() + tab.slice(1)}Btn`);
            if (currentTabBtn) currentTabBtn.classList.add("active");
            renderList();
        };

        const triggerManualRun = () => {
            toast.info("正在重新扫描并自动签到...");
            storage.remove(KEY_TOPICS_ALL);
            runCheckin(true);
        };

        return VM.createElement(VM.Fragment, null,
            VM.createElement("div", { className: "configContainer" },
                VM.createElement("div", { className: "panelTitle" },
                    VM.createElement("span", null, "微博超话自动签到"),
                    VM.createElement("span", { className: "refreshBtn", title: "重新扫描与签到", onClick: triggerManualRun }, "🔄")
                ),
                VM.createElement("label", { className: "cItem" },
                    VM.createElement("span", null, "自动签到"),
                    VM.createElement("input", {
                        type: "checkbox",
                        checked: config.AUTO_SIGN,
                        onInput: e => updateState({ AUTO_SIGN: e.target.checked })
                    })
                ),
                VM.createElement("label", { className: "cItem" },
                    VM.createElement("span", null, "显示气泡提示"),
                    VM.createElement("input", {
                        type: "checkbox",
                        checked: config.SHOW_TOAST,
                        onInput: e => updateState({ SHOW_TOAST: e.target.checked })
                    })
                ),
                VM.createElement("label", { className: "cItem" },
                    VM.createElement("span", null, "气泡延迟 (ms)"),
                    VM.createElement("input", {
                        type: "number",
                        value: config.TIMEOUT,
                        min: "0",
                        onInput: e => updateState({ TIMEOUT: parseInt(e.target.value, 10) || 2000 })
                    })
                ),
                VM.createElement("div", { id: "statusProgressText", className: "statusText" }),
                VM.createElement("div", { className: "tabGroup" },
                    VM.createElement("button", { id: "tabAllBtn", className: "tabBtn active", onClick: () => switchTab("all") }, "全部"),
                    VM.createElement("button", { id: "tabSignedBtn", className: "tabBtn", onClick: () => switchTab("signed") }, "已签"),
                    VM.createElement("button", { id: "tabPendingBtn", className: "tabBtn", onClick: () => switchTab("pending") }, "待签")
                ),
                VM.createElement("div", { id: "wbTopicListContainer", className: "topicListContainer" }),
                VM.createElement("div", { className: "action", onClick: togglePanel }, "📋 超话签到")
            ),
            VM.createElement("style", null, cssStyle)
        );
    }

    function setStatusText(text) {
        const el = document.getElementById("statusProgressText");
        if (el) el.textContent = text || "";
    }

    async function runCheckin(force = false) {
        const lastCheck = storage.get(KEY_LAST_CHECK);

        if (isNewDay(lastCheck)) {
            storage.remove(KEY_SIGNED_ARR);
            storage.remove(KEY_TOPICS_ALL);
            storage.set(KEY_IS_CHECK, false);
        }

        let allTopics = storage.get(KEY_TOPICS_ALL) || [];
        let signedArr = (storage.get(KEY_SIGNED_ARR) || []).map(n => (n || "").trim());

        try {
            // 首次获取或强制刷新时，重新获取关注列表与实时签到状态
            if (allTopics.length === 0 || force) {
                setStatusText("正在获取超话列表并识别签到状态...");
                const { topics, signedNames } = await fetchTopicsWithStatus();
                allTopics = topics.map(t => ({ id: t.id, name: (t.name || "").trim(), scheme: t.scheme || "" }));
                storage.set(KEY_TOPICS_ALL, allTopics);

                // 核心：若从服务端识别出已签超话（在其他设备或手动已签），立刻同步并存入 signedArr
                if (signedNames && signedNames.length > 0) {
                    const signedSet = new Set([...signedArr, ...signedNames.map(n => (n || "").trim())]);
                    signedArr = Array.from(signedSet);
                    storage.set(KEY_SIGNED_ARR, signedArr);
                }
            }

            renderList();

            // 过滤真正待签到的超话
            let pendingTopics = allTopics.filter(t => !signedArr.includes((t.name || "").trim()));

            const isCheckedToday = storage.get(KEY_IS_CHECK) === true && !isNewDay(lastCheck);

            // 如果不是强制刷新，且今日已完全签到或没有待签项目，直接退出，不再次触发表单/气泡
            if (!force && (isCheckedToday || (pendingTopics.length === 0 && !isNewDay(lastCheck)))) {
                setStatusText("今日已完成签到");
                storage.set(KEY_IS_CHECK, true);
                storage.set(KEY_LAST_CHECK, Date.now());
                renderList();
                return;
            }

            // 如果此时待签项为空（即所有关注超话已经在其他设备或手动签到完毕）
            if (pendingTopics.length === 0) {
                const autoDetectCount = signedArr.length;
                toast.success(`所有超话今日均已签到完成！(已识别 ${autoDetectCount} 个已签超话，无需重复签到)`);
                setStatusText("所有超话已签到完成");
                storage.set(KEY_IS_CHECK, true);
                storage.set(KEY_LAST_CHECK, Date.now());
                renderList();
                return;
            }

            toast.info(`关注共 ${allTopics.length} 个超话，已识别 ${signedArr.length} 个已签，剩余 ${pendingTopics.length} 个待签，正在为您签到...`);

            const queue = new PromiseQueue({ concurrency: 1, minTimeout: 1000, maxTimeout: 1800 });
            let doneCount = 0;

            for (const item of pendingTopics) {
                doneCount++;
                setStatusText(`签到中 (${doneCount}/${pendingTopics.length}): ${item.name}`);
                await queue.add(() => signInterest(item).catch(() => {}));
            }

            const updatedSigned = (storage.get(KEY_SIGNED_ARR) || []).map(n => (n || "").trim());
            const remaining = allTopics.filter(t => !updatedSigned.includes((t.name || "").trim()));

            storage.set(KEY_LAST_CHECK, Date.now());

            if (remaining.length === 0) {
                storage.set(KEY_IS_CHECK, true);
                setStatusText("全部签到任务处理完毕");
                toast.success("超话自动签到任务处理完毕！");
            } else {
                storage.set(KEY_IS_CHECK, false);
                setStatusText(`签到处理完成，剩余 ${remaining.length} 个未成功`);
                toast.warn(`部分超话未签上，仍然剩余 ${remaining.length} 个待签项`);
            }
            renderList();
        } catch (err) {
            console.error("[微博超话自动签到] 运行出错:", err);
            setStatusText("获取超话列表失败");
            toast.error("获取关注超话列表失败，请确认是否登录微博");
        }
    }

    function initDOM() {
        const mount = () => {
            if (document.body && !document.querySelector(".configContainer")) {
                const panel = ConfigPanel();
                document.body.appendChild(panel);
                renderList();
            }
        };

        if (document.body) {
            mount();
        } else {
            document.addEventListener("DOMContentLoaded", mount);
        }
    }

    function main() {
        if (!storage.get(KEY_CONFIG)) {
            storage.set(KEY_CONFIG, DEFAULT_CONFIG);
        }
        initDOM();
        if (config.AUTO_SIGN) {
            setTimeout(() => runCheckin(false), 2000);
        }
    }

    main();
})();
